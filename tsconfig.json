/*
 * Configurazione del browser.
 *
 * I tipi di Cloudflare Workers NON vanno qui: ridefiniscono globali che esistono anche
 * nel DOM (Request, Response, e perfino il significato di append su un elemento) e il
 * risultato sono errori incomprensibili in file che non c'entrano niente. Il Worker ha
 * la sua configurazione separata, tsconfig.worker.json.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["src", "shared", "tests/lib"]
}
