{
  "name": "ricordi-nfc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "dev:web": "vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "heic-to": "^1.5.2",
    "hono": "^4.6.14",
    "maplibre-gl": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241224.0",
    "@playwright/test": "^1.62.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "2.1.8",
    "wrangler": "^3.99.0"
  }
}
