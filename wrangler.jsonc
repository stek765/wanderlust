{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricordi-nfc",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],

  // Il Worker serve anche il sito statico: un solo deploy, un solo dominio, zero CORS.
  // "none" è voluto: se lasciassimo gestire il fallback agli asset, index.html
  // risponderebbe anche a /api/*. Il fallback lo fa il Worker esplicitamente, in fondo
  // alle rotte, dopo aver escluso API e media.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricordi",
      // Creato il 12/08/2026, regione WEUR. In locale questo valore non viene usato:
      // `wrangler dev` crea un SQLite finto sotto .wrangler/ e ignora l'id.
      "database_id": "29531b1d-76e8-4388-9eef-999c594af6e3",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Creato il 12/08/2026. In locale wrangler emula il bucket su disco.
      "bucket_name": "ricordi-media"
    }
  ],

  // Backup settimanale dell'indice: domenica alle 4:00 UTC.
  //
  // `SUN` e non `0`: nel cron di Cloudflare il giorno della settimana va da 1 a 7 (oppure
  // per nome), e non esiste il giorno 0 della convenzione unix. Con `0 4 * * 0` il Worker
  // sale lo stesso e poi il deploy fallisce sul trigger — "invalid cron string" —
  // lasciando il sito online ma senza backup.
  "triggers": {
    "crons": ["0 4 * * SUN"]
  },

  "observability": {
    "enabled": true
  }
}
